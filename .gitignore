# Runtime-generated, request-scoped state - never source content. Scoped narrowly: knowledge/ itself
# stays tracked, only its own runtime subfolders are excluded.
**/temp-workspaces/
knowledge/.drafts/
knowledge/.history/

# Secrets of connected accounts (Gmail OAuth client, token encryption key) - never in git.
secrets.key
config/gmail-client.json
*client_secret*.json
