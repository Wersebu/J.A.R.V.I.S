<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.7</version>
        <relativePath/>
    </parent>

    <groupId>com.jarvis</groupId>
    <artifactId>jarvis-parent</artifactId>
    <version>2.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Jarvis</name>
    <description>Headless AI operating system backend foundation.</description>

    <modules>
        <module>jarvis-common</module>
        <module>jarvis-brain-router</module>
        <module>jarvis-api</module>
        <module>jarvis-knowledge</module>
        <module>jarvis-core</module>
        <module>jarvis-memory</module>
        <module>jarvis-ollama</module>
        <module>jarvis-planner</module>
        <module>jarvis-tools</module>
        <module>jarvis-plugin-sdk</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <jarvis.version>2.3.0</jarvis.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.jarvis</groupId>
                <artifactId>jarvis-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jarvis</groupId>
                <artifactId>jarvis-brain-router</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jarvis</groupId>
                <artifactId>jarvis-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jarvis</groupId>
                <artifactId>jarvis-knowledge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jarvis</groupId>
                <artifactId>jarvis-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jarvis</groupId>
                <artifactId>jarvis-ollama</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jarvis</groupId>
                <artifactId>jarvis-planner</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jarvis</groupId>
                <artifactId>jarvis-tools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jarvis</groupId>
                <artifactId>jarvis-plugin-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <directory>${maven.multiModuleProjectDirectory}/javac-output-test/${project.artifactId}</directory>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>


