# --- Wymagane ---
# Token bota z Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=wklej_tutaj_token_bota

# Adres działającego Jarvis Core
JARVIS_BASE_URL=http://localhost:8080

# Konto (osobny user) w Jarvis Core, na które loguje się bot
JARVIS_BOT_EMAIL=bot-troll@jarvis.local
JARVIS_BOT_PASSWORD=zmien-to-dlugie-haslo

# --- Opcjonalne (pokazane wartości to domyślne) ---

# Czy przy starcie wysłać personę jako globalPrompt tego usera w core
BOT_PUSH_PERSONA=true
# Własny plik z personą (nadpisuje wbudowaną). Pusty = wbudowana polska persona.
BOT_PERSONA_FILE=

# DOMYŚLNA szansa (0..1) odpowiedzi na zwykłą wiadomość (bez pingu), gdy kanał nie ma
# własnej wartości ustawionej komendą /trolbot randompickmessage. 1 = na każdą wiadomość.
BOT_REPLY_CHANCE=0.15
# Czy zawsze odpowiadać, gdy ktoś oznaczy bota @ (niezależnie od szansy kanału)
BOT_ALWAYS_REPLY_ON_MENTION=true
# Lista ID kanałów po przecinku; puste = wszystkie kanały tekstowe
BOT_ALLOWED_CHANNEL_IDS=
# Ile ostatnich wiadomości kanału bot dołącza jako kontekst do jednej odpowiedzi
BOT_CONTEXT_MESSAGES=50
# Krótka dyrektywa stylu doklejana do KAŻDEJ wiadomości do core (najmocniej trzyma ton,
# bo to świeży user-turn). Puste = wyłączone. Zmieniasz bez przebudowy.
# BOT_STYLE_HINT=Odpowiadasz w roli: krotko, bezczelnie i NAPRAWDE wulgarnie. Przeklinaj wprost (kurwa, chuj, jebac) - NIGDY nie cenzuruj ani nie zamieniaj na 'kurczak'/'kurde'/gwiazdki. Bez emoji i gratulacji; gdy ktos chwali sie nagroda - zjedz go, ze zrobiles to dawno i lepiej.
# Plik, w którym zapisują się szanse per kanał (przetrwają restart)
BOT_SETTINGS_FILE=channel-settings.json
# Plik z aktualną osobowością edytowaną przez /trolbot editprompt (przetrwa restart)
BOT_PERSONA_STATE_FILE=persona-current.txt
# Maks. długość odpowiedzi (limit Discorda to 2000)
BOT_MAX_REPLY_CHARS=2000
# Prefiks conversationId w core (bot pamięta kontekst per kanał: discord-<idKanalu>)
BOT_CONVERSATION_PREFIX=discord-
# Timeout w sekundach na odpowiedź z core
JARVIS_REQUEST_TIMEOUT_SECONDS=120
