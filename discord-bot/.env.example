# --- Wymagane ---
# Token bota z Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=wklej_tutaj_token_bota

# Adres działającego Jarvis Core
JARVIS_BASE_URL=http://localhost:8080

# Konto (osobny user) w Jarvis Core, na które loguje się bot
JARVIS_BOT_EMAIL=bot-troll@jarvis.local
JARVIS_BOT_PASSWORD=zmien-to-dlugie-haslo

# --- Opcjonalne (pokazane wartości to domyślne) ---

# Czy przy starcie wysłać personę jako globalPrompt tego usera w core
BOT_PUSH_PERSONA=true
# Własny plik z personą (nadpisuje wbudowaną). Pusty = wbudowana polska persona.
BOT_PERSONA_FILE=

# Szansa (0..1) na odezwanie się do zwykłej wiadomości (bez oznaczenia bota)
BOT_REPLY_CHANCE=0.15
# Czy zawsze odpowiadać, gdy ktoś oznaczy bota @ (pomija szansę i cooldown)
BOT_ALWAYS_REPLY_ON_MENTION=true
# Minimalny odstęp w sekundach między niezamówionymi odzywkami na tym samym kanale
BOT_CHANNEL_COOLDOWN_SECONDS=20
# Lista ID kanałów po przecinku; puste = wszystkie kanały tekstowe
BOT_ALLOWED_CHANNEL_IDS=
# Maks. długość odpowiedzi (limit Discorda to 2000)
BOT_MAX_REPLY_CHARS=2000
# Prefiks conversationId w core (bot pamięta kontekst per kanał: discord-<idKanalu>)
BOT_CONVERSATION_PREFIX=discord-
# Timeout w sekundach na odpowiedź z core
JARVIS_REQUEST_TIMEOUT_SECONDS=120
