# /etc/jarvis-voice.env - settings of the Jarvis voice server (restart: sudo systemctl restart jarvis-voice)
JV_HOST=127.0.0.1
JV_PORT=8100
JV_LANGUAGE=pl

# Speech recognition (faster-whisper): small (fast, CPU) | medium (good) | large-v3 / turbo (best, GPU)
JV_STT_MODEL=medium
JV_STT_DEVICE=auto

# Jarvis's voice:
#   edge  - Microsoft neural voices (pl-PL-MarekNeural, pl-PL-ZofiaNeural), very natural, needs internet
#   piper - offline (pl_PL-darkman-medium, pl_PL-gosia-medium), download with install.sh --piper
#   xtts  - your own cloned voice: put a 10-30 s clean recording at /opt/jarvis-voice/voices/jarvis.wav
JV_TTS_ENGINE=edge
JV_VOICE=pl-PL-MarekNeural
# deeper/higher edge voice, e.g. -6Hz
JV_EDGE_PITCH=+0Hz
JV_VOICES_DIR=/opt/jarvis-voice/voices
