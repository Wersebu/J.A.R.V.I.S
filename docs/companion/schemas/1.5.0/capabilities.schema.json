{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contractVersion",
    "tasks",
    "taskPlans",
    "planEvidenceRequired",
    "durableHistory",
    "voiceStreaming"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.5.0"
    },
    "tasks": {
      "const": true
    },
    "taskPlans": {
      "const": true
    },
    "planEvidenceRequired": {
      "const": true
    },
    "durableHistory": {
      "type": "boolean"
    },
    "voiceStreaming": {
      "const": false
    },
    "providerMode": {
      "enum": [
        "LIVE",
        "SIMULATED"
      ]
    },
    "inferenceTelemetry": {
      "type": "boolean"
    },
    "asyncDelegation": {
      "type": "boolean"
    },
    "taskInstructions": {
      "type": "boolean"
    }
  }
}
