{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "revision",
    "subject",
    "predicate",
    "content",
    "confidence",
    "category",
    "state",
    "conflictWith",
    "createdAt",
    "updatedAt",
    "expiresAt",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "predicate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "category": {
      "enum": [
        "SEMANTIC",
        "PREFERENCE",
        "PROJECT",
        "TEMPORARY"
      ]
    },
    "state": {
      "enum": [
        "ACTIVE",
        "CONFLICT",
        "PENDING_REVIEW",
        "SUPERSEDED"
      ]
    },
    "conflictWith": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "conversationId",
          "requestId",
          "timestamp"
        ],
        "properties": {
          "conversationId": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
