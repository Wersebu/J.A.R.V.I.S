{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Companion commands 1.6.0",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "state.sync"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "afterSequence"
      ],
      "properties": {
        "type": {
          "const": "events.resume"
        },
        "afterSequence": {
          "type": "integer",
          "minimum": 0
        },
        "serverInstanceId": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  ]
}
