{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "type",
    "requestId",
    "conversationId"
  ],
  "properties": {
    "type": {
      "enum": [
        "CHAT_CANCEL",
        "CHAT_STEER",
        "CHAT_RESUME"
      ]
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "conversationId": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "afterSeq": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "CHAT_STEER"
          }
        }
      },
      "then": {
        "required": [
          "message"
        ]
      }
    }
  ],
  "additionalProperties": true
}
