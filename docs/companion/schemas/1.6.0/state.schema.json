{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Companion snapshot 1.6.0",
  "type": "object",
  "required": [
    "contractVersion",
    "serverInstanceId",
    "latestSequence",
    "tasks",
    "activeProcesses",
    "plans"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.6.0"
    },
    "serverInstanceId": {
      "type": "string",
      "format": "uuid"
    },
    "latestSequence": {
      "type": "integer",
      "minimum": 0
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "task.schema.json"
      }
    },
    "activeProcesses": {
      "type": "integer",
      "minimum": 0
    },
    "plans": {
      "type": "array",
      "items": {
        "$ref": "plan.schema.json"
      }
    },
    "metrics": {
      "$ref": "metrics.schema.json"
    }
  }
}
