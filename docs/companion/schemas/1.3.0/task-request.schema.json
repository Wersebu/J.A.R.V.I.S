{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Submit companion task 1.3.0",
  "type": "object",
  "required": [
    "message"
  ],
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32000,
      "pattern": ".*\\S.*"
    },
    "role": {
      "enum": [
        "TASK",
        "RESEARCH"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "maxAttempts": {
      "const": 1
    }
  }
}
