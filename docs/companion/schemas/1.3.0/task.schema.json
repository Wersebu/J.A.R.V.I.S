{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Companion Task 1.3.0",
  "type": "object",
  "required": [
    "taskId",
    "role",
    "state",
    "priority",
    "progress",
    "createdAt",
    "updatedAt",
    "result",
    "error"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "role": {
      "enum": [
        "CONVERSATION",
        "TASK",
        "RESEARCH",
        "MEMORY",
        "PROACTIVE"
      ]
    },
    "state": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "CANCEL_REQUESTED",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "TIMED_OUT"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "progress": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
